# Copy to .env (git-ignored) and fill in. Never commit real keys.

# openrouter | gemini | fake   (without a key the app falls back to the fake client)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Thinking tokens count against LLM_MAX_TOKENS; "minimal" keeps NPC replies complete. none = model default.
# Some models reject "minimal" (e.g. gemini-3.7-flash -> HTTP 400): use "low" there.
GEMINI_THINKING_LEVEL=minimal
# Free tier: about 20 requests/day per model. If one model is overloaded (503) or out of quota (429),
# another model has its own quota, e.g. gemini-3.5-flash-lite.

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=400
